# Python仮想環境(各自で作り直す。SETUP.md参照)
venv/
__pycache__/
*.pyc

# macOS固有のパッチ済みpybullet wheel(68MB、環境依存バイナリのため同梱しない)
# ビルド方法は docs/SETUP.md を参照
vendor/*.whl

# 実行時に自動生成される一時URDF(すべてPythonコードから生成される)
ev3way_ep*.urdf
plane_simple*.urdf
plane_population.urdf
ev3way_population_ball.urdf
ev3way.urdf

# 学習中の中間チェックポイント(known_good/ に確定版がある)
checkpoints/

# 作業用の重みファイル(known_good/ が正本。続きから学習する際はそこからコピーする)
/ev3way_w1.npy
/ev3way_w2.npy
/ev3way_w1_*.npy
/ev3way_w2_*.npy
/ev3way_sac_w*.npy
/ev3way_v1*_w*.npy
*.npy.bak_*

.DS_Store
